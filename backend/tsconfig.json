{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "rootDir": "./",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,

    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,

    "resolveJsonModule": true,

    "types": ["node"]
  },

  "include": [
    "src/**/*",
    "prisma/**/*"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}